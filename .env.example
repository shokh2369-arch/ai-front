# ─────────────────────────────────────────────────────────────
# start.ai — web frontend configuration
#
# Base URL of the Go backend, without a trailing /api.
#   Vercel: set it in Project → Settings → Environment Variables;
#           api/proxy.js forwards /api/* there (the browser stays same-origin,
#           since the API sends no CORS headers).
#   Local:  dev-server.js reads it from here; unset → http://127.0.0.1:8080
#
# e.g. API_BASE_URL=https://my-backend.onrender.com
API_BASE_URL=
